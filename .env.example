# Vercel Frontend Environment Variables Template
# Set these in your Vercel Project Settings -> Environment Variables:

# 1. URL of your deployed Go backend on Render (without trailing slash)
NEXT_PUBLIC_SERVER_URL="https://bigbiz-backend.onrender.com"
NEXT_PUBLIC_API_BASE_URL="https://bigbiz-backend.onrender.com/api"

# 2. Vercel deployment URL of this frontend
NEXT_PUBLIC_CLIENT_URL="https://your-app.vercel.app"

# 3. Security & Pepper (must match PASSWORD_PEPPER on the backend)
NEXT_PUBLIC_PASSWORD_PEPPER="c3VwZXJTZWNyZXRQZXBwZXJLZXkxMjM0NTY3OA=="

# 4. Debug Mode (set to 'false' for production, 'true' for local testing)
NEXT_PUBLIC_DEBUG="false"

# 5. Cloudinary Media
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="bigbiz"
NEXT_PUBLIC_CLOUDINARY_PRESET="bizsocial_posts"

# 6. Payment Gateways
NEXT_PUBLIC_EWALLET_GATEWAY_URL="https://lyren-client.vercel.app"
NEXT_PUBLIC_CHAIN_HOOK_GATEWAY_URL="https://chain-hook-backend-evj9.vercel.app"
